# PostHog product analytics (optional).
# Copy this file to .env.local and fill in your own project's values.
# .env.local is gitignored and must NOT be committed.
#
# The project API key (phc_...) is safe to expose in the browser — it only
# grants event ingestion. Never put a Personal API key (phx_...) here.
#
# NEXT_PUBLIC_* vars are inlined at BUILD time, so they must be present in the
# environment when `opennextjs-cloudflare build` runs (deploy step), not just
# as a Cloudflare Worker runtime variable.

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Ahrefs Web Analytics (optional). The data-key is a public site identifier,
# safe to expose in the browser. Leave blank to disable — the script won't load.
AHREFS_ANALYTICS_KEY=

# Supabase auth + user database (optional).
# Without these, the auth layer no-ops and the public tracker still works.
# From Supabase dashboard → Project Settings → API.
#
# The URL and anon key are safe to expose in the browser (the anon key is
# protected by Row Level Security). The service role key is SECRET — it bypasses
# RLS — so it must never be committed or shipped to the client. Set it only in
# .env.local locally and as a Cloudflare Worker secret in production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key for app-sent transactional email (the one-time welcome email).
# Secret; server-only. Requires the sender domain to be verified in Resend.
RESEND_API_KEY=
